// Iluminação Pública Inteligente — Prefeitura de Itaguari, GO
// Modelo de dados derivado da seção 7 do PRD.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Status do poste, derivado da telemetria (PRD seção 6).
enum StatusPoste {
  NORMAL // consumo dentro da média esperada do trecho
  CONSUMO_ALTO // consumo acima da média do trecho nas últimas 24h
  FALHA_OFFLINE // ausência de telemetria por intervalo definido; abre chamado automático
  MANUTENCAO // atribuído manualmente pelo técnico
}

/// Tipo de evento capturado pelo sensor de câmera 360°.
enum TipoEventoSensor {
  VEICULO_DETECTADO // luminosidade sobe para o pico (100%)
  RETORNO_AO_PISO // luminosidade volta ao piso (50%)
}

/// Sentido do veículo em relação ao poste.
enum SentidoVeiculo {
  APROXIMANDO
  AFASTANDO
}

/// Janela de agregação de consumo.
enum PeriodoAgregado {
  DIA
  SEMANA
  MES
  ANO
}

/// Poste de iluminação pública da rede simulada de Itaguari.
model Poste {
  id                   String      @id @default(uuid())
  codigo               String      @unique /// ex.: "P-042"
  endereco             String
  bairro               String
  latitude             Float
  longitude            Float
  cidade               String      @default("Itaguari")
  uf                   String      @default("GO")
  status               StatusPoste @default(NORMAL)
  luminosidadeAtual    Int         @default(50) /// percentual: piso 50, pico 100
  consumoInstantaneoKw Float       @default(0)
  ultimaLeituraEm      DateTime?
  criadoEm             DateTime    @default(now())
  atualizadoEm         DateTime    @updatedAt

  leituras    LeituraTelemetria[]
  eventos     EventoSensor[]
  agregados   AgregadoConsumo[]
  dispositivo Dispositivo?

  @@index([status])
  @@index([bairro])
  @@map("postes")
}

/// Leitura de telemetria enviada por um poste (ingestão IoT / MQTT).
model LeituraTelemetria {
  id              String   @id @default(uuid())
  posteId         String
  poste           Poste    @relation(fields: [posteId], references: [id], onDelete: Cascade)
  timestamp       DateTime @default(now())
  consumoKw       Float
  luminosidadePct Int

  @@index([posteId, timestamp])
  @@map("leituras_telemetria")
}

/// Evento do sensor 360° (log exibido no detalhe do poste).
model EventoSensor {
  id                     String           @id @default(uuid())
  posteId                String
  poste                  Poste            @relation(fields: [posteId], references: [id], onDelete: Cascade)
  timestamp              DateTime         @default(now())
  tipo                   TipoEventoSensor
  sentido                SentidoVeiculo?
  luminosidadeResultante Int

  @@index([posteId, timestamp])
  @@map("eventos_sensor")
}

/// Consumo agregado por período. posteId nulo = agregado geral da rede.
model AgregadoConsumo {
  id              String          @id @default(uuid())
  posteId         String?
  poste           Poste?          @relation(fields: [posteId], references: [id], onDelete: Cascade)
  periodo         PeriodoAgregado
  periodoInicio   DateTime
  periodoFim      DateTime
  consumoTotalKwh Float
  custoTotalReais Float
  calculadoEm     DateTime        @default(now())

  @@unique([posteId, periodo, periodoInicio])
  @@index([periodo, periodoInicio])
  @@map("agregados_consumo")
}

// --- Catálogo da plataforma (RF-CEN-01 a 03, RF-DIS-01, 02 e 06) -----------
// Hierarquia: inquilino → local (site) → área → dispositivo. Domínios e perfis
// são dados do inquilino, não código: um domínio novo nasce por configuração.

/// Organização dona dos dados (ex.: Prefeitura de Itaguari).
model Inquilino {
  id           String   @id @default(uuid())
  slug         String   @unique /// usado nos tópicos MQTT: {inquilino}/...
  nome         String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  sites        Site[]
  dominios     Dominio[]
  perfis       PerfilDispositivo[]
  dispositivos Dispositivo[]

  @@map("inquilinos")
}

/// Local (site): bairro na cidade, fazenda no campo. Geometria GeoJSON.
model Site {
  id           String    @id @default(uuid())
  inquilinoId  String
  inquilino    Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  slug         String
  nome         String
  tipo         String    @default("bairro") /// livre: bairro, fazenda, campus...
  geometria    Json? /// GeoJSON (Point ou Polygon), coordenadas [lon, lat]
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  areas        Area[]
  dispositivos Dispositivo[]

  @@unique([inquilinoId, slug])
  @@map("sites")
}

/// Área dentro de um local: rua, praça, talhão, silo. Geometria GeoJSON.
model Area {
  id           String   @id @default(uuid())
  siteId       String
  site         Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  slug         String
  nome         String
  tipo         String   @default("rua") /// livre: rua, praca, talhao, silo...
  geometria    Json? /// GeoJSON (Point, LineString, MultiLineString, Polygon...)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  dispositivos Dispositivo[]

  @@unique([siteId, slug])
  @@map("areas")
}

/// Domínio do catálogo do inquilino (iluminacao, energia, pecuaria...).
model Dominio {
  id           String    @id @default(uuid())
  inquilinoId  String
  inquilino    Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  slug         String /// usado nos tópicos MQTT: .../{dominio}/...
  nome         String
  descricao    String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  dispositivos Dispositivo[]

  @@unique([inquilinoId, slug])
  @@map("dominios")
}

/// Perfil de dispositivo: grandezas, unidades, faixa válida e intervalo
/// esperado de envio. Não pertence a um domínio: é reutilizável entre projetos.
model PerfilDispositivo {
  id              String    @id @default(uuid())
  inquilinoId     String
  inquilino       Inquilino @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  slug            String
  nome            String
  descricao       String?
  /// [{ grandeza, unidade (UCUM), minimo?, maximo? }]
  grandezas       Json
  intervaloEnvioS Int /// intervalo esperado entre mensagens, em segundos
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  dispositivos Dispositivo[]

  @@unique([inquilinoId, slug])
  @@map("perfis_dispositivo")
}

/// Dispositivo cadastrado na plataforma. Os 248 postes são dispositivos do
/// domínio "iluminacao" (ligados ao poste pelo `posteId`).
model Dispositivo {
  id               String            @id @default(uuid())
  inquilinoId      String
  inquilino        Inquilino         @relation(fields: [inquilinoId], references: [id], onDelete: Cascade)
  codigo           String /// usado nos tópicos MQTT: .../{dispositivo}/...
  nome             String
  dominioId        String
  dominio          Dominio           @relation(fields: [dominioId], references: [id], onDelete: Restrict)
  perfilId         String
  perfil           PerfilDispositivo @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  siteId           String
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Restrict)
  areaId           String?
  area             Area?             @relation(fields: [areaId], references: [id], onDelete: SetNull)
  fabricante       String
  modelo           String?
  firmware         String
  latitude         Float?
  longitude        Float?
  posteId          String?           @unique
  poste            Poste?            @relation(fields: [posteId], references: [id], onDelete: SetNull)
  ultimaMensagemEm DateTime?
  criadoEm         DateTime          @default(now())
  atualizadoEm     DateTime          @updatedAt

  credenciais    CredencialDispositivo[]
  mensagens      MensagemIngerida[]
  ultimosValores UltimoValor[]
  alarmes        Alarme[]

  @@unique([inquilinoId, codigo])
  @@index([dominioId])
  @@index([siteId])
  @@index([perfilId])
  @@map("dispositivos")
}

/// Credencial (token) de um dispositivo. Só o hash fica guardado: o token é
/// mostrado uma única vez, na emissão. Revogada = recusada na próxima conexão.
model CredencialDispositivo {
  id            String      @id @default(uuid())
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  prefixo       String      @unique /// parte pública do token, para localizar a credencial
  hash          String /// SHA-256 do token completo
  emitidaEm     DateTime    @default(now())
  revogadaEm    DateTime?

  @@index([dispositivoId])
  @@map("credenciais_dispositivo")
}

// --- Pipeline de ingestão (RF-ING-01 a 04, 06 e 08, RF-PRO-01, RF-DAD-01 e 02)
// receber → autenticar → validar → deduplicar → ordenar → enriquecer → publicar

/// Mensagem canônica aceita, já enriquecida com o cadastro (inquilino, domínio,
/// local e área). `idMensagem` único = a mesma mensagem nunca entra duas vezes.
model MensagemIngerida {
  id            String      @id @default(uuid())
  idMensagem    String      @unique /// id_mensagem gerado na origem
  inquilinoId   String
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  dominioId     String
  siteId        String
  areaId        String?
  tipo          String /// telemetria | evento | estado
  medidoEm      DateTime /// horário da medição (é por ele que o histórico é ordenado)
  recebidoEm    DateTime    @default(now())
  canal         String /// http | lote | mqtt
  via           String? /// nó de borda ou gateway
  atrasada      Boolean /// chegou depois do limite de offline do perfil
  conteudo      Json /// mensagem canônica enriquecida

  medicoes Medicao[]

  @@index([dispositivoId, medidoEm])
  @@index([tipo, medidoEm])
  @@map("mensagens")
}

/// Série temporal: uma linha por medida de telemetria.
model Medicao {
  id             BigInt           @id @default(autoincrement())
  mensagemId     String
  mensagem       MensagemIngerida @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  inquilinoId    String
  dispositivoId  String
  dominioId      String
  siteId         String
  areaId         String?
  grandeza       String
  valor          Float
  unidade        String /// unidade do perfil (já normalizada)
  medidoEm       DateTime
  suspeita       Boolean          @default(false) /// fora da faixa do perfil
  motivoSuspeita String?

  @@index([dispositivoId, grandeza, medidoEm])
  @@index([areaId, grandeza, medidoEm])
  @@index([siteId, grandeza, medidoEm])
  @@map("medicoes")
}

/// Último valor de cada grandeza de cada dispositivo (sem consultar o histórico).
/// Dado atrasado não sobrescreve um valor mais novo.
model UltimoValor {
  dispositivoId String
  dispositivo   Dispositivo @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  grandeza      String
  valor         Float
  unidade       String
  medidoEm      DateTime
  suspeita      Boolean     @default(false)
  atualizadoEm  DateTime    @updatedAt

  @@id([dispositivoId, grandeza])
  @@map("ultimos_valores")
}

/// Fila de mensagens inválidas (DLQ): tudo o que o pipeline recusou, com o motivo.
model MensagemInvalida {
  id          String   @id @default(uuid())
  recebidoEm  DateTime @default(now())
  canal       String
  etapa       String /// autenticar | validar | enriquecer
  motivo      String
  erros       Json /// lista de erros (ex.: os do JSON Schema)
  dispositivo String?
  idMensagem  String?
  topico      String?
  payload     Json?

  @@index([recebidoEm])
  @@map("mensagens_invalidas")
}

// --- Regras e alarmes (RF-PRO-02, 03 e 05) --------------------------------

enum SeveridadeAlarme {
  INFO
  AVISO
  CRITICO
}

enum StatusAlarme {
  ATIVO
  RECONHECIDO
  RESOLVIDO
}

/// Regra condição → ação, configurada pela API. Escopo opcional por domínio,
/// local, área (geográfica), perfil ou dispositivo.
model Regra {
  id            String           @id @default(uuid())
  inquilinoId   String
  nome          String
  descricao     String?
  ativa         Boolean          @default(true)
  dominioId     String?
  siteId        String?
  areaId        String?
  perfilId      String?
  dispositivoId String?
  /// { tipo: "limite", grandeza, operador, valor, duracaoS? } | { tipo: "ausencia", duracaoS }
  condicao      Json
  severidade    SeveridadeAlarme @default(AVISO)
  /// [{ tipo: "alarme" | "notificar" | "comando" | "webhook" | "publicar", ... }]
  acoes         Json
  criadoEm      DateTime         @default(now())
  atualizadoEm  DateTime         @updatedAt

  alarmes   Alarme[]
  execucoes ExecucaoAcao[]

  @@index([inquilinoId, ativa])
  @@map("regras")
}

/// Alarme com ciclo de vida: ATIVO → RECONHECIDO → RESOLVIDO.
model Alarme {
  id             String           @id @default(uuid())
  inquilinoId    String
  regraId        String?
  regra          Regra?           @relation(fields: [regraId], references: [id], onDelete: SetNull)
  dispositivoId  String
  dispositivo    Dispositivo      @relation(fields: [dispositivoId], references: [id], onDelete: Cascade)
  origem         String /// regra (central) | borda (diagnóstico do fog)
  severidade     SeveridadeAlarme
  status         StatusAlarme     @default(ATIVO)
  titulo         String
  detalhe        String?
  grandeza       String?
  valor          Float?
  ocorridoEm     DateTime /// quando aconteceu (hora da medição ou do diagnóstico na borda)
  criadoEm       DateTime         @default(now())
  reconhecidoEm  DateTime?
  reconhecidoPor String?
  resolvidoEm    DateTime?
  resolvidoPor   String? /// usuário, ou "automático" quando a condição deixa de valer
  comentario     String?

  execucoes ExecucaoAcao[]

  @@index([status, severidade])
  @@index([dispositivoId, status])
  @@index([regraId, status])
  @@map("alarmes")
}

/// Cada ação disparada por uma regra, com o resultado e as tentativas.
model ExecucaoAcao {
  id          String    @id @default(uuid())
  regraId     String?
  regra       Regra?    @relation(fields: [regraId], references: [id], onDelete: SetNull)
  alarmeId    String?
  alarme      Alarme?   @relation(fields: [alarmeId], references: [id], onDelete: SetNull)
  tipo        String /// alarme | notificar | comando | webhook | publicar
  destino     String?
  status      String /// ok | falha
  tentativas  Int       @default(1)
  erro        String?
  criadoEm    DateTime  @default(now())
  concluidoEm DateTime?

  @@index([regraId, criadoEm])
  @@map("execucoes_acao")
}
