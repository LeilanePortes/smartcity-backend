# Conexão com o PostgreSQL (ver docker-compose.yml para os valores do container local).
# Rodando a API pelo compose (serviço `app`), o host é `postgres` e não `localhost`
# — o próprio compose já sobrescreve esta variável nesse caso.
DATABASE_URL="postgresql://smartcity:smartcity@localhost:5432/iluminacao_publica?schema=public"

# Porta HTTP do backend NestJS.
PORT=3000

# Simulador de telemetria IoT (Fase 2). Deixe SIMULADOR_ENABLED=false para
# subir a API sem o worker (ex.: rodar testes ou inspecionar dados estáticos).
SIMULADOR_ENABLED=true
SIMULADOR_INTERVALO_SENSORES_MS=5000
SIMULADOR_INTERVALO_TELEMETRIA_MS=10000
SIMULADOR_INTERVALO_STATUS_MS=30000
SIMULADOR_INTERVALO_LIMPEZA_MS=21600000
SIMULADOR_RETENCAO_DIAS=40

# Camada edge (serviço `edge` do docker compose): os 248 postes simulados que
# publicam no broker MQTT. Fora do compose, MQTT_URL e EDGE_API_URL apontam para
# localhost (mqtt://localhost:1883 e http://localhost:3000).
EDGE_VERSAO_FIRMWARE=2.4.1
EDGE_INTERVALO_SENSORES_MS=5000
EDGE_INTERVALO_TELEMETRIA_MS=10000
EDGE_INTERVALO_SAUDE_MS=30000
EDGE_INTERVALO_FALHAS_MS=30000

# --- Só valem ao subir a stack pelo docker compose (serviço `app`) ------------
# Preparação do banco no start do container:
#   auto  (default) seed + backfill apenas quando o banco ainda não tem postes
#   force roda sempre, recriando rede e histórico
#   skip  só aplica as migrations
DB_BOOTSTRAP=auto

# Tamanho do histórico gerado no bootstrap (também usados por `bun run db:backfill`):
# dias de telemetria/eventos brutos e dias de agregados diários dos KPIs.
DIAS_RAW=30
DIAS_AGREGADO=740
